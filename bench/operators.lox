// operators.lox — operator dense, minimal literals.
// Stresses the one-or-two character lookahead path (! = < > each followed by a
// possible '='), and the single-character dispatch arms. Very high token
// density per byte: this file produces more tokens per KB than any other in
// the corpus, so it isolates per-token dispatch cost from scanning cost.

var a=1;var b=2;var c=3;var d=4;var e=5;var f=6;var g=7;var h=8;

print a==b;print a!=b;print a<b;print a<=b;print a>b;print a>=b;
print b==c;print b!=c;print b<c;print b<=c;print b>c;print b>=c;
print c==d;print c!=d;print c<d;print c<=d;print c>d;print c>=d;
print d==e;print d!=e;print d<e;print d<=e;print d>e;print d>=e;

print !a;print !!a;print !(a==b);print !(a!=b);print !(a<=b);print !(a>=b);

a=b;b=c;c=d;d=e;e=f;f=g;g=h;h=a;
a=a+b;b=b-c;c=c*d;d=d/e;e=e+f;f=f-g;g=g*h;h=h/a;
a=(a+b)*(c-d)/(e+f)-(g*h);
b=((a))+(((b)))-((((c))))*(((((d)))));

if(a==b and c!=d or e<f and g>=h){print a;}else{print b;}
if(!(a<b) and !(c>d) or !(e<=f) and !(g>=h)){print c;}else{print d;}

while(a<100){a=a+1;if(a>50 and a!=75){b=b*2;}else{b=b-1;}}
for(var i=0;i<100;i=i+1){for(var j=0;j<10;j=j+1){a=a+i*j;}}

var t1={};var t2={};var t3={};
fun k(p,q,r,s){return p+q-r*s;}
print k(1,2,3,4)+k(5,6,7,8)-k(9,1,2,3)*k(4,5,6,7)/k(8,9,1,2);

a=-b;b=-c;c=-d;d=-e;
a=a*-1;b=b/-1;c=c+-1;d=d--1;
print a.b;print a.b.c;print a.b.c.d;print a.b.c.d.e;
